# Final analysis-ready outcome and control datasets
!/data/processed/
!/data/processed/polocentro_event_study/
/data/processed/polocentro_event_study/*
!/data/processed/polocentro_event_study/amc_year_outcomes.parquet
!/data/processed/polocentro_event_study/amc_year_controls.parquet
!/data/processed/polocentro_event_study/metadata.json

